MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=plate_access_control
MYSQL_USER=gatekeeper
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_TIME_ZONE=+08:00

# Central camera worker. Keep this key private; it authenticates the local
# recognition worker when it posts plate results back to the server. The worker
# can capture a camera directly over the local LAN without a tunnel.
CAMERA_WORKER_KEY=replace_with_a_long_random_worker_key
PLATE_SERVER_URL=http://127.0.0.1:8080
PLATE_DETECTOR_MODEL=/path/to/license_plate_detector.onnx
PLATE_RECOGNIZER_MODEL=/path/to/en_PP-OCRv5_rec_mobile.onnx
# start the worker from web/start_web.sh; set to 0 only when running it separately
CAMERA_WORKER_ENABLED=1
CAMERA_WORKER_POLL_SECONDS=0.5

# Optional secret-backed camera endpoint. Prefer this for RTSP credentials so
# the password is not stored in the cameras table. Replace the suffix with the
# uppercase camera ID, converting dots/dashes/colons to underscores.
# CAMERA_ENDPOINT_VILLAGE_A_MAIN_CAMERA=rtsp://username:password@192.168.0.124:554/stream1

# Dormant mobile-account integration. Leave disabled until the separate
# account service has been deployed and its authenticated sync is implemented.
MOBILE_ACCOUNT_INTEGRATION_ENABLED=0
MOBILE_ACCOUNT_SERVICE_URL=
MOBILE_ACCOUNT_SYNC_SECRET=
